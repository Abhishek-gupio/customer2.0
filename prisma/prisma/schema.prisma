generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["driverAdapters", "multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "customer", "customer_app", "dm_project", "gupio_crm", "tech_park"]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("customer")
}

model Customer {
  id          String                @id @default(cuid())
  phoneNumber String                @unique
  email       String?
  fullName    String?
  profilePic  String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  devices     CustomerDevice[]
  documents   CustomerDocument[]
  vehicles    CustomerVehicle[]
  digilocker  DigiLockerConnection?

  @@schema("customer")
}

model CustomerDevice {
  id           String   @id @default(cuid())
  customerId   String
  platform     String
  deviceToken  String?
  deviceInfo   String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@schema("customer")
}

model CustomerDocument {
  id                 String             @id @default(cuid())
  customerId         String
  vehicleId          String?
  type               DocumentType
  documentNumber     String?
  issueDate          DateTime?
  expiryDate         DateTime?
  issuerName         String?
  fileUrl            String
  thumbnailUrl       String?
  fileSize           Int?
  mimeType           String?
  ocrData            Json?
  extractedFields    Json?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         String?
  source             DocumentSource     @default(UPLOAD)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle            CustomerVehicle?   @relation(fields: [vehicleId], references: [id])

  @@index([customerId])
  @@index([vehicleId])
  @@index([type])
  @@schema("customer")
}

model DigiLockerConnection {
  id           String           @id @default(cuid())
  customerId   String           @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String?
  consentId    String?
  consentDate  DateTime?
  status       DigiLockerStatus @default(CONNECTED)
  lastSyncAt   DateTime?
  connectedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@schema("customer")
}

model CustomerVehicle {
  id                 String              @id @default(cuid())
  customerId         String
  registrationNumber String              @unique
  make               String?
  model              String?
  variant            String?
  year               Int?
  fuelType           String?
  vehicleType        String?
  currentOdometer    Int?                @default(0)
  registrationDate   DateTime?
  rcVerified         Boolean             @default(false)
  isActive           Boolean             @default(true)
  isPrimary          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  documents          CustomerDocument[]
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  healthScore        VehicleHealthScore?

  @@index([customerId])
  @@schema("customer")
}

model VehicleHealthScore {
  id               String          @id @default(cuid())
  vehicleId        String          @unique
  overallScore     Int             @default(100)
  ageScore         Int?
  mileageScore     Int?
  maintenanceScore Int?
  drivingScore     Int?
  explanations     Json?
  recommendations  Json?
  lastCalculated   DateTime        @default(now())
  nextDueDate      DateTime?
  vehicle          CustomerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@schema("customer")
}

model BankAccountDetails {
  id                    String   @id
  bankAccountNumber     String
  ifscCode              String
  bankAccountHolderName String
  bankDocuments         String
  documentId            String   @unique
  Document              Document @relation(fields: [documentId], references: [id])

  @@schema("public")
}

model Client {
  id                                  String                                @id
  clientType                          CLIENT_TYPE
  clientName                          String
  clientAddress                       String
  clientEmail                         String                                @unique
  contactNumber                       String                                @unique
  city                                String
  state                               String
  pincode                             String
  admin1Name                          String
  admin1Email                         String
  admin1Phone                         String
  admin2Name                          String
  admin2Email                         String
  admin2Phone                         String
  financeName                         String
  financeEmail                        String
  financePhone                        String
  gstNumber                           String?
  panNumber                           String
  paymentTerms                        String
  paymentMode                         PAYMENT_MODE
  ifsc                                String
  bankAccHolderName                   String
  accountNumber                       String
  depositAmount                       Float                                 @default(0)
  depositDate                         DateTime?
  companyLogo                         String?
  siteId                              String
  isActive                            ClientStatus                          @default(ACTIVE)
  createdAt                           DateTime                              @default(now())
  updatedAt                           DateTime
  password                            String
  serviceEndTime                      String
  serviceStartTime                    String
  isQrVerified                        Boolean                               @default(false)
  servicesProvided                    String?
  allottedParkingSlots                Int                                   @default(0)
  documents                           Json                                  @default("[]")
  googleFormId                        String?
  googleFormUrl                       String?
  parentId                            String?
  tenantRole                          ClientTenantRole?
  Client                              Client?                               @relation("ClientToClient", fields: [parentId], references: [id], onDelete: Restrict)
  other_Client                        Client[]                              @relation("ClientToClient")
  Site                                Site                                  @relation(fields: [siteId], references: [id])
  ClientNotification                  ClientNotification[]
  Customer                            public_Customer[]
  Invoice                             Invoice[]
  ParkingSlot                         ParkingSlot[]
  Pickup                              Pickup[]
  SelfParking                         SelfParking[]
  Ticket                              Ticket[]
  User                                public_User[]
  client_email_verifications          client_email_verifications[]
  client_password_resets              client_password_resets[]
  super_admin_client_assigned_clients super_admin_client_assigned_clients[]

  @@index([clientEmail])
  @@index([createdAt])
  @@index([isActive])
  @@index([parentId])
  @@index([parentId, tenantRole])
  @@index([siteId])
  @@schema("public")
}

model ClientNotification {
  id        String                   @id
  clientId  String
  type      CLIENT_NOTIFICATION_TYPE
  title     String
  message   String
  metadata  Json?
  isRead    Boolean                  @default(false)
  createdAt DateTime                 @default(now())
  updatedAt DateTime
  Client    Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([createdAt])
  @@index([isRead])
  @@index([type])
  @@schema("public")
}

model ContactForm {
  id                  String               @id
  name                String
  email               String
  phone               String
  companyName         String?
  communicationMethod COMMUNICATION_METHOD
  city                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime

  @@index([city])
  @@index([communicationMethod])
  @@index([createdAt])
  @@index([email])
  @@schema("public")
}

model public_Customer {
  id              String            @id
  fullName        String
  email           String            @unique
  phoneNumber     String            @unique
  password        String
  status          CustomerStatus    @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  clientId        String?
  image           String?
  isActive        Boolean           @default(true)
  Client          Client?           @relation(fields: [clientId], references: [id])
  CustomerRequest CustomerRequest[]

  @@index([clientId])
  @@index([email])
  @@index([isActive])
  @@index([phoneNumber])
  @@index([status])
  @@map("Customer")
  @@schema("public")
}

model CustomerRequest {
  id          String          @id
  status      REQUEST_STATUS  @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime
  customerId  String
  notes       String?
  requestType String
  vehicleId   String
  Customer    public_Customer @relation(fields: [customerId], references: [id])
  Vehicle     Vehicle         @relation(fields: [vehicleId], references: [id])

  @@index([createdAt])
  @@index([customerId])
  @@index([requestType])
  @@index([status])
  @@index([vehicleId])
  @@schema("public")
}

model Document {
  id                   String              @id
  aadharNumber         String
  aadharFrontImage     String?
  aadharBackImage      String?
  voterIdNumber        String
  voterIdImage         String
  panCardNumber        String
  panCardImage         String
  drivingLicenseNumber String
  drivingLicenseImage  String
  localAddressProof    String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime
  userId               String
  BankAccountDetails   BankAccountDetails?
  User                 public_User         @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@schema("public")
}

model HelpSupport {
  id        String              @id
  message   String
  userId    String?
  createdAt DateTime            @default(now())
  updatedAt DateTime
  subject   String
  status    HELP_SUPPORT_STATUS @default(PENDING)

  @@index([createdAt])
  @@index([status])
  @@index([subject])
  @@index([userId])
  @@schema("public")
}

model Invoice {
  id            String         @id
  invoiceNumber String         @unique
  clientId      String
  status        INVOICE_STATUS @default(PENDING)
  issueDate     DateTime
  dueDate       DateTime
  subtotal      Float
  taxAmount     Float
  totalAmount   Float
  notes         String?
  pdfUrl        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  Client        Client         @relation(fields: [clientId], references: [id])
  InvoiceItem   InvoiceItem[]

  @@index([clientId])
  @@index([dueDate])
  @@index([invoiceNumber])
  @@index([issueDate])
  @@index([status])
  @@schema("public")
}

model InvoiceItem {
  id          String  @id
  invoiceId   String
  name        String
  description String?
  quantity    Int
  unitPrice   Float
  amount      Float
  Invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@schema("public")
}

model LeaveRequest {
  id                                   String       @id
  userId                               String
  startDate                            DateTime
  endDate                              DateTime
  reason                               String?
  status                               LEAVE_STATUS @default(PENDING)
  approvedById                         String?
  createdAt                            DateTime     @default(now())
  updatedAt                            DateTime
  leaveType                            LEAVE_TYPE
  adminNote                            String?
  User_LeaveRequest_approvedByIdToUser public_User? @relation("LeaveRequest_approvedByIdToUser", fields: [approvedById], references: [id])
  User_LeaveRequest_userIdToUser       public_User  @relation("LeaveRequest_userIdToUser", fields: [userId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@schema("public")
}

model ParkingSlot {
  id        String     @id
  clientId  String
  status    SlotStatus @default(AVAILABLE)
  slotLabel String?
  createdAt DateTime   @default(now())
  updatedAt DateTime
  Client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, status])
  @@schema("public")
}

model Pickup {
  id                                        String        @id
  vehicleId                                 String
  valetId                                   String
  siteId                                    String?
  status                                    PICKUP_STATUS @default(PICKED_UP)
  notes                                     String?
  pickupFrom                                String?
  parkAt                                    String?
  meterPhotoUrl                             String?
  vehiclePhotoUrl                           String?
  vehicleVideoUrl                           String?
  pickupTime                                DateTime      @default(now())
  createdAt                                 DateTime      @default(now())
  updatedAt                                 DateTime
  dropTime                                  DateTime?
  droppedByValetId                          String?
  dropLocation                              String?
  clientId                                  String?
  pendingDropLocation                       String?
  pendingDropTime                           DateTime?
  pendingDroppedByValetId                   String?
  pendingDropNotes                          String?
  Client                                    Client?       @relation(fields: [clientId], references: [id])
  User_Pickup_droppedByValetIdToUser        public_User?  @relation("Pickup_droppedByValetIdToUser", fields: [droppedByValetId], references: [id])
  User_Pickup_pendingDroppedByValetIdToUser public_User?  @relation("Pickup_pendingDroppedByValetIdToUser", fields: [pendingDroppedByValetId], references: [id])
  Site                                      Site?         @relation(fields: [siteId], references: [id])
  User_Pickup_valetIdToUser                 public_User   @relation("Pickup_valetIdToUser", fields: [valetId], references: [id])
  Vehicle                                   Vehicle       @relation(fields: [vehicleId], references: [id])

  @@index([clientId])
  @@index([createdAt])
  @@index([dropTime])
  @@index([droppedByValetId])
  @@index([status, createdAt])
  @@index([status])
  @@index([updatedAt])
  @@index([valetId])
  @@index([valetId, status])
  @@index([valetId, vehicleId])
  @@index([vehicleId])
  @@schema("public")
}

model SelfParking {
  id                  String       @id
  vehicleNumber       String
  vehiclePhoto        String
  entryTime           DateTime     @default(now())
  exitTime            DateTime?
  valetId             String?
  siteId              String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime
  clientId            String?
  contactNumber       String?
  isRegistered        Boolean      @default(false)
  ownerName           String?
  vehicleColor        String?
  vehicleManufacturer String?
  Client              Client?      @relation(fields: [clientId], references: [id])
  Site                Site?        @relation(fields: [siteId], references: [id])
  User                public_User? @relation(fields: [valetId], references: [id])

  @@index([clientId])
  @@index([createdAt])
  @@index([entryTime])
  @@index([exitTime])
  @@index([isRegistered])
  @@index([siteId, clientId])
  @@index([siteId])
  @@index([valetId])
  @@index([vehicleNumber])
  @@schema("public")
}

model ShiftAttendance {
  id             String       @id
  userId         String
  startTime      DateTime     @default(now())
  startPhotoUrl  String
  startLatitude  Float
  startLongitude Float
  startAddress   String
  endTime        DateTime?
  endPhotoUrl    String?
  endLatitude    Float?
  endLongitude   Float?
  endAddress     String?
  totalMinutes   Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  status         SHIFT_STATUS @default(ACTIVE)
  User           public_User  @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@schema("public")
}

model Site {
  id                  String              @id
  siteName            String
  siteOwnerName       String
  ownerPhoneNumber    String
  ownerEmail          String?
  pincode             String
  city                String
  state               String
  siteAddress         String
  bankAccName         String
  accountNumber       String
  ifsc                String
  startDate           DateTime
  endDate             DateTime
  noticePeriod        Int
  lockInPeriod        Int
  depositAmount       Float
  monthlyRental       Float
  sitePaymentMethod   SITE_PAYMENT_METHOD
  latitude            String
  longitude           String
  sitePictures        String[]
  status              SITE_STATUS         @default(ACTIVE)
  valetCount          Int                 @default(0)
  supervisorCount     Int                 @default(0)
  depositDate         DateTime?
  siteDocuments       Json                @default("[]")
  fourWheelerCapacity Int                 @default(0)
  twoWheelerCapacity  Int                 @default(0)
  siteLength          String
  siteWidth           String
  operatorEmail       String
  operatorName        String
  operatorPhone       String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  Client              Client[]
  Pickup              Pickup[]
  SelfParking         SelfParking[]
  SiteAssigned        SiteAssigned[]
  Vehicle             Vehicle[]

  @@index([city])
  @@index([createdAt])
  @@index([status])
  @@schema("public")
}

model SiteAssigned {
  id         String      @id
  userId     String
  siteId     String
  role       VALET_ROLE
  assignedAt DateTime    @default(now())
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime
  clientId   String?
  Site       Site        @relation(fields: [siteId], references: [id])
  User       public_User @relation(fields: [userId], references: [id])

  @@unique([userId, siteId])
  @@index([clientId])
  @@index([isActive])
  @@index([siteId])
  @@index([userId])
  @@index([userId, isActive])
  @@schema("public")
}

model Ticket {
  id            String          @id
  ticketId      String          @unique
  clientId      String
  subject       String
  category      TICKET_CATEGORY
  description   String
  priority      TICKET_PRIORITY
  status        TICKET_STATUS   @default(OPEN)
  attachments   String[]
  assignedTo    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  admins        admins?         @relation(fields: [assignedTo], references: [id])
  Client        Client          @relation(fields: [clientId], references: [id])
  TicketComment TicketComment[]

  @@index([assignedTo])
  @@index([category])
  @@index([clientId])
  @@index([priority])
  @@index([status])
  @@index([ticketId])
  @@schema("public")
}

model TicketComment {
  id            String   @id
  ticketId      String
  senderId      String
  message       String
  attachmentUrl String?
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())
  Ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([senderId])
  @@index([ticketId])
  @@schema("public")
}

model public_User {
  id                                           String            @id
  fullName                                     String
  email                                        String            @unique
  phoneNumber                                  String            @unique
  city                                         String
  state                                        String
  pinCode                                      String
  applyingFor                                  VALET_ROLE
  password                                     String
  profilePic                                   String
  createdAt                                    DateTime          @default(now())
  updatedAt                                    DateTime
  employeeNumber                               Int               @default(autoincrement())
  employeeId                                   String?           @unique
  status                                       UserStatus        @default(IN_ACTIVE)
  permanentAddress                             String            @default("")
  clientId                                     String?
  dateOfBirth                                  DateTime
  gender                                       Gender
  maritalStatus                                MaritalStatus
  alternatePhoneNumber                         String
  currentAddress                               String
  fatherName                                   String
  fatherContactNumber                          String
  dateOfJoining                                DateTime
  workingLocation                              String
  workingSiteName                              String
  shiftTiming                                  ShiftTiming
  tShirtSize                                   TShirtSize
  pantSize                                     PantSize
  Document                                     Document[]
  LeaveRequest_LeaveRequest_approvedByIdToUser LeaveRequest[]    @relation("LeaveRequest_approvedByIdToUser")
  LeaveRequest_LeaveRequest_userIdToUser       LeaveRequest[]    @relation("LeaveRequest_userIdToUser")
  Pickup_Pickup_droppedByValetIdToUser         Pickup[]          @relation("Pickup_droppedByValetIdToUser")
  Pickup_Pickup_pendingDroppedByValetIdToUser  Pickup[]          @relation("Pickup_pendingDroppedByValetIdToUser")
  Pickup_Pickup_valetIdToUser                  Pickup[]          @relation("Pickup_valetIdToUser")
  SelfParking                                  SelfParking[]
  ShiftAttendance                              ShiftAttendance[]
  SiteAssigned                                 SiteAssigned[]
  Client                                       Client?           @relation(fields: [clientId], references: [id])

  @@index([applyingFor])
  @@index([clientId])
  @@index([createdAt])
  @@index([status])
  @@map("User")
  @@schema("public")
}

model Vehicle {
  id              String            @id
  vehicleNumber   String            @unique
  vehicleType     VEHICLE_TYPE
  vehicleModel    String
  vehicleColor    String
  ownerName       String
  ownerPhone      String
  isPhoneVerified Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  siteId          String?
  ownerEmail      String?
  status          VehicleStatus     @default(PARKED)
  vehicleBrand    String
  CustomerRequest CustomerRequest[]
  Pickup          Pickup[]
  Site            Site?             @relation(fields: [siteId], references: [id])

  @@index([ownerEmail])
  @@index([ownerPhone])
  @@index([status])
  @@index([vehicleNumber])
  @@schema("public")
}

model admin_email_verifications {
  id        String   @id
  adminId   String
  email     String
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  admins    admins   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
  @@index([isUsed])
  @@index([otp])
  @@schema("public")
}

model admin_password_resets {
  id        String   @id
  adminId   String
  email     String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  admins    admins   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([email])
  @@index([expiresAt])
  @@index([isUsed])
  @@index([token])
  @@schema("public")
}

model admins {
  id                        String                      @id
  fullName                  String
  email                     String                      @unique
  phoneNumber               String?                     @unique
  password                  String
  profilePic                String?
  bio                       String?
  role                      String                      @default("admin")
  isEmailVerified           Boolean                     @default(false)
  emailVerifiedAt           DateTime?
  lastLoginAt               DateTime?
  socialLinks               Json?
  address                   Json?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  departmentId              String?
  roleId                    String?
  status                    AdminStatus                 @default(PENDING)
  Ticket                    Ticket[]
  admin_email_verifications admin_email_verifications[]
  admin_password_resets     admin_password_resets[]
  departments               departments?                @relation(fields: [departmentId], references: [id])
  roles                     roles?                      @relation(fields: [roleId], references: [id])
  approval_logs             approval_logs[]

  @@index([departmentId])
  @@index([email])
  @@index([isEmailVerified])
  @@index([roleId])
  @@index([status])
  @@schema("public")
}

model approval_logs {
  id         String         @id
  adminId    String
  approvedBy String?
  action     ApprovalAction
  status     ApprovalStatus
  comments   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime
  admins     admins         @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([adminId])
  @@index([status])
  @@schema("public")
}

model client_email_verifications {
  id        String   @id
  clientId  String
  email     String
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  Client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
  @@index([isUsed])
  @@index([otp])
  @@schema("public")
}

model client_password_resets {
  id        String   @id
  clientId  String
  email     String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  Client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([email])
  @@index([expiresAt])
  @@index([isUsed])
  @@index([token])
  @@schema("public")
}

model customer_fcm_tokens {
  id          Int      @id @default(autoincrement())
  customerId  String
  token       String
  device_info Json?
  is_active   Boolean  @default(true)
  last_seen   DateTime @default(now())
  created_at  DateTime @default(now())
  updated_at  DateTime

  @@unique([customerId, token], map: "customer_fcm_tokens_customer_id_token_key")
  @@index([customerId])
  @@index([is_active])
  @@index([last_seen])
  @@schema("public")
}

model departments {
  id          String   @id
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  admins      admins[]
  roles       roles[]

  @@index([isActive])
  @@index([name])
  @@schema("public")
}

model fcm_tokens {
  id          Int      @id @default(autoincrement())
  userId      String
  token       String
  device_info Json?
  is_active   Boolean  @default(true)
  last_seen   DateTime @default(now())
  created_at  DateTime @default(now())
  updated_at  DateTime

  @@unique([userId, token], map: "fcm_tokens_user_id_token_key")
  @@index([is_active])
  @@index([last_seen])
  @@index([userId])
  @@schema("public")
}

model permissions {
  id               String             @id
  name             String             @unique
  module           String
  description      String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  role_permissions role_permissions[]

  @@index([isActive])
  @@index([module])
  @@index([name])
  @@schema("public")
}

model role_permissions {
  id           String      @id
  roleId       String
  permissionId String
  createdAt    DateTime    @default(now())
  permissions  permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  roles        roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([roleId])
  @@schema("public")
}

model roles {
  id               String             @id
  name             String
  departmentId     String?
  description      String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  isSuperAdmin     Boolean            @default(false)
  permissionKeys   Json?
  permissionsMask  BigInt             @default(0)
  admins           admins[]
  role_permissions role_permissions[]
  departments      departments?       @relation(fields: [departmentId], references: [id])

  @@unique([name, departmentId])
  @@index([departmentId])
  @@index([isActive])
  @@index([isSuperAdmin])
  @@schema("public")
}

model super_admin_client_assigned_clients {
  superAdminClientId  String
  clientId            String
  Client              Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  super_admin_clients super_admin_clients @relation(fields: [superAdminClientId], references: [id], onDelete: Cascade)

  @@id([superAdminClientId, clientId])
  @@index([clientId])
  @@index([superAdminClientId])
  @@schema("public")
}

model super_admin_clients {
  id                                  String                                @id
  fullName                            String
  email                               String                                @unique
  password                            String
  isActive                            Boolean                               @default(true)
  createdAt                           DateTime                              @default(now())
  updatedAt                           DateTime
  super_admin_client_assigned_clients super_admin_client_assigned_clients[]

  @@index([email])
  @@index([isActive])
  @@schema("public")
}

