generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["driverAdapters", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "public")]
  schemas    = ["customer", "public"]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("customer")
}

model Customer {
  id                String                @id @default(cuid())
  phoneNumber       String                @unique
  email             String?
  fullName          String?
  profilePic        String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  googleId          String?               @unique
  chats             ChatSession[]
  devices           CustomerDevice[]
  documents         CustomerDocument[]
  vehicles          CustomerVehicle[]
  digilocker        DigiLockerConnection?
  emergencyContacts EmergencyContact[]
  expenses          Expense[]
  driverExpenses    Expense[]             @relation("DriverExpenses")
  budgets           ExpenseBudget[]
  notifications     InAppNotification[]
  sosRequests       SOSRequest[]
  supportTickets    SupportTicket[]
  sharedVehicles    VehicleAccess[]

  @@schema("customer")
}

model CustomerDevice {
  id           String   @id @default(cuid())
  customerId   String
  platform     String
  deviceToken  String?
  deviceInfo   String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@schema("customer")
}

model CustomerDocument {
  id                 String             @id @default(cuid())
  customerId         String
  vehicleId          String?
  type               DocumentType
  documentNumber     String?
  issueDate          DateTime?
  expiryDate         DateTime?
  issuerName         String?
  fileUrl            String
  thumbnailUrl       String?
  fileSize           Int?
  mimeType           String?
  ocrData            Json?
  extractedFields    Json?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         String?
  source             DocumentSource     @default(UPLOAD)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle            CustomerVehicle?   @relation(fields: [vehicleId], references: [id])

  @@index([customerId])
  @@index([vehicleId])
  @@index([type])
  @@schema("customer")
}

model DigiLockerConnection {
  id           String           @id @default(cuid())
  customerId   String           @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String?
  consentId    String?
  consentDate  DateTime?
  status       DigiLockerStatus @default(CONNECTED)
  lastSyncAt   DateTime?
  connectedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@schema("customer")
}

model CustomerVehicle {
  id                 String              @id @default(cuid())
  customerId         String
  registrationNumber String              @unique
  make               String?
  model              String?
  variant            String?
  year               Int?
  fuelType           String?
  vehicleType        String?
  currentOdometer    Int?                @default(0)
  registrationDate   DateTime?
  rcVerified         Boolean             @default(false)
  isActive           Boolean             @default(true)
  isPrimary          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  chassisNumber      String?
  engineNumber       String?
  imageUrl           String?
  ownerName          String?
  rto                String?
  vehicleClass       String?
  fuelNorms          String?
  transmission       String?
  priceRange         String?
  rating             String?
  rcStatus           String?
  unloadedWeight     String?
  fitnessUpto        String?
  insuranceUpto      String?
  pollutionUpto      String?
  mileage            String?
  brand              String?
  color              String?
  seatingCapacity    String?
  cylinderCount      String?
  cubicCapacity      String?
  grossWeight        String?
  bodyType           String?
  challans           Challan[]
  documents          CustomerDocument[]
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  drivingTrips       DrivingTrip[]
  expenses           Expense[]
  odometerLogs       OdometerLog[]
  serviceRecords     ServiceRecord[]
  telematicsDevice   TelematicsDevice?
  accessList         VehicleAccess[]
  healthScore        VehicleHealthScore?

  @@index([customerId])
  @@schema("customer")
}

model OdometerLog {
  id        String          @id @default(cuid())
  vehicleId String
  reading   Int
  date      DateTime        @default(now())
  createdAt DateTime        @default(now())
  vehicle   CustomerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@schema("customer")
}

model Challan {
  id            String          @id @default(cuid())
  vehicleId     String
  challanNumber String          @unique
  amount        Int
  status        String
  date          DateTime
  violationType String
  location      String?
  source        String
  lastCheckedAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  vehicle       CustomerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@schema("customer")
}

model VehicleAccess {
  id         String          @id @default(cuid())
  vehicleId  String
  customerId String
  role       AccessRole      @default(VIEWER)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle    CustomerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, customerId])
  @@schema("customer")
}

model VehicleHealthScore {
  id               String          @id @default(cuid())
  vehicleId        String          @unique
  overallScore     Int             @default(100)
  ageScore         Int?
  mileageScore     Int?
  maintenanceScore Int?
  drivingScore     Int?
  explanations     Json?
  recommendations  Json?
  lastCalculated   DateTime        @default(now())
  nextDueDate      DateTime?
  vehicle          CustomerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@schema("customer")
}

model InAppNotification {
  id         String    @id @default(cuid())
  customerId String
  title      String
  body       String
  type       String
  link       String?
  metadata   Json?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@schema("customer")
}

model ChatSession {
  id         String        @id @default(cuid())
  customerId String
  title      String?
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  summary    String?
  messages   ChatMessage[]
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@schema("customer")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  content   String
  metadata  Json?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@schema("customer")
}

model DocumentEmbedding {
  id         String                 @id @default(cuid())
  customerId String
  entityId   String
  entityType String
  content    String
  createdAt  DateTime               @default(now())
  vector     Unsupported("vector")?

  @@index([customerId])
  @@index([entityId])
  @@schema("customer")
}

model ChatAnalytics {
  id             String   @id @default(cuid())
  customerId     String
  sessionId      String
  toolName       String?
  intent         String?
  responseTimeMs Int?
  messageCount   Int      @default(1)
  hadToolCall    Boolean  @default(false)
  hadImage       Boolean  @default(false)
  wasStreaming   Boolean  @default(false)
  feedback       Int?
  createdAt      DateTime @default(now())

  @@index([customerId])
  @@index([sessionId])
  @@index([createdAt])
  @@schema("customer")
}

model Expense {
  id           String           @id @default(cuid())
  customerId   String
  vehicleId    String?
  amount       Float
  currency     String           @default("INR")
  category     ExpenseCategory
  date         DateTime         @default(now())
  merchantName String?
  location     String?
  notes        String?
  source       ExpenseSource    @default(MANUAL)
  receiptUrl   String?
  mimeType     String?
  rawText      String?
  isAutomated  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  driverId     String?
  placeAddress String?
  placeId      String?
  placeLat     Float?
  placeLng     Float?
  placeName    String?
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  driver       Customer?        @relation("DriverExpenses", fields: [driverId], references: [id])
  vehicle      CustomerVehicle? @relation(fields: [vehicleId], references: [id])

  @@index([customerId])
  @@index([vehicleId])
  @@index([category])
  @@schema("customer")
}

model ExpenseBudget {
  id              String          @id @default(cuid())
  customerId      String
  category        ExpenseCategory
  amount          Float
  period          String          @default("MONTHLY")
  notifyThreshold Int             @default(80)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, category])
  @@schema("customer")
}

model FuelPriceCache {
  id        String   @id @default(cuid())
  city      String
  state     String
  fuelType  String
  price     Float
  date      DateTime @default(now())
  source    String   @default("IOCL_API")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([city, fuelType, date])
  @@index([city, fuelType])
  @@schema("customer")
}

model DiscoveryContent {
  id        String   @id @default(cuid())
  type      String
  content   Json
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, date])
  @@schema("customer")
}

model ServiceRecord {
  id                String          @id @default(cuid())
  vehicleId         String
  expenseId         String?
  serviceType       String
  garageName        String?
  odometerAtService Int?
  serviceDate       DateTime        @default(now())
  nextServiceDate   DateTime?
  nextServiceKm     Int?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  parts             ServicePart[]
  vehicle           CustomerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@schema("customer")
}

model ServicePart {
  id                 String          @id @default(cuid())
  serviceRecordId    String
  partType           ServicePartType
  partName           String?
  brand              String?
  cost               Float?
  warrantyMonths     Int?
  warrantyKm         Int?
  warrantyExpiresAt  DateTime?
  lastReplacedAt     DateTime        @default(now())
  nextReplacementDue DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  serviceRecord      ServiceRecord   @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  @@index([serviceRecordId])
  @@index([partType])
  @@schema("customer")
}

model PartReplacementInterval {
  id                    String          @id @default(cuid())
  make                  String
  model                 String?
  yearMin               Int?
  yearMax               Int?
  partType              ServicePartType
  intervalMonths        Int
  intervalKm            Int
  defaultWarrantyMonths Int             @default(0)
  source                String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([make, model, yearMin, yearMax, partType])
  @@index([partType])
  @@index([make, model])
  @@schema("customer")
}

model TelematicsDevice {
  id          String          @id @default(cuid())
  vehicleId   String          @unique
  instanceId  String          @unique
  deviceToken String?
  platform    String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lastSyncAt  DateTime?
  vehicle     CustomerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@schema("customer")
}

model DrivingTrip {
  id            String          @id @default(cuid())
  vehicleId     String
  tripId        String          @unique
  startTime     DateTime
  endTime       DateTime
  distanceKm    Float
  durationMin   Float
  maxSpeed      Float?
  avgSpeed      Float?
  fuelConsumed  Float?
  safetyScore   Int
  startLocation Json?
  endLocation   Json?
  status        String
  createdAt     DateTime        @default(now())
  events        DrivingEvent[]
  vehicle       CustomerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([startTime])
  @@schema("customer")
}

model DrivingEvent {
  id        String      @id @default(cuid())
  tripId    String
  eventType String
  timestamp DateTime
  latitude  Float
  longitude Float
  severity  Float?
  speed     Float?
  createdAt DateTime    @default(now())
  trip      DrivingTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@schema("customer")
}

model SOSRequest {
  id         String    @id @default(cuid())
  customerId String
  latitude   Float
  longitude  Float
  address    String?
  status     SOSStatus @default(ACTIVE)
  type       SOSType   @default(OTHER)
  metadata   Json?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@schema("customer")
}

model EmergencyContact {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  phoneNumber String
  relation    String?
  priority    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  email       String?
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@schema("customer")
}

model SupportTicket {
  id          String          @id @default(cuid())
  customerId  String
  subject     String
  description String
  status      TicketStatus    @default(OPEN)
  priority    TicketPriority  @default(MEDIUM)
  category    TicketCategory  @default(OTHER)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages    TicketMessage[]

  @@index([customerId])
  @@index([status])
  @@schema("customer")
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  senderId   String
  senderRole String
  content    String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@schema("customer")
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("customer")
}

model BankAccountDetails {
  id                    String   @id
  bankAccountNumber     String
  ifscCode              String
  bankAccountHolderName String
  bankDocuments         String
  documentId            String   @unique
  Document              Document @relation(fields: [documentId], references: [id])

  @@schema("public")
}

model Client {
  id                         String                       @id
  clientType                 CLIENT_TYPE
  clientName                 String
  clientAddress              String
  clientEmail                String                       @unique
  contactNumber              String                       @unique
  city                       String
  state                      String
  pincode                    String
  admin1Name                 String
  admin1Email                String
  admin1Phone                String
  admin2Name                 String
  admin2Email                String
  admin2Phone                String
  financeName                String
  financeEmail               String
  financePhone               String
  gstNumber                  String?
  panNumber                  String
  paymentTerms               String
  paymentMode                PAYMENT_MODE
  ifsc                       String
  bankAccHolderName          String
  accountNumber              String
  depositAmount              Float                        @default(0)
  depositDate                DateTime?
  companyLogo                String?
  documents                  Json                         @default("[]")
  siteId                     String
  isActive                   ClientStatus                 @default(ACTIVE)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  password                   String
  serviceStartTime           String
  serviceEndTime             String
  isQrVerified               Boolean                      @default(false)
  servicesProvided           String?
  allottedParkingSlots       Int                          @default(0)
  googleFormId               String?
  googleFormUrl              String?
  parentId                   String?
  tenantRole                 ClientTenantRole?
  parkingMode                String?                      @default("NORMAL")
  dropRequestEnabled         Boolean                      @default(true)
  Client                     Client?                      @relation("ClientToClient", fields: [parentId], references: [id], onDelete: Restrict)
  other_Client               Client[]                     @relation("ClientToClient")
  Site                       Site                         @relation(fields: [siteId], references: [id])
  ClientNotification         ClientNotification[]
  Customer                   public_Customer[]
  Invoice                    Invoice[]
  OperatorClientAssignment   OperatorClientAssignment[]
  ParkingSlot                ParkingSlot[]
  Payment                    Payment[]
  Pickup                     Pickup[]
  SelfParking                SelfParking[]
  Ticket                     Ticket[]
  User                       public_User[]
  client_email_verifications client_email_verifications[]
  client_password_resets     client_password_resets[]

  @@index([clientEmail])
  @@index([createdAt])
  @@index([isActive])
  @@index([parentId])
  @@index([parentId, tenantRole])
  @@index([siteId])
  @@schema("public")
}

model ClientNotification {
  id        String                   @id
  clientId  String
  type      CLIENT_NOTIFICATION_TYPE
  title     String
  message   String
  metadata  Json?
  isRead    Boolean                  @default(false)
  createdAt DateTime                 @default(now())
  updatedAt DateTime
  Client    Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([createdAt])
  @@index([isRead])
  @@index([type])
  @@schema("public")
}

model ContactForm {
  id                  String               @id
  name                String
  email               String
  phone               String
  companyName         String?
  communicationMethod COMMUNICATION_METHOD
  city                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime

  @@index([city])
  @@index([communicationMethod])
  @@index([createdAt])
  @@index([email])
  @@schema("public")
}

model public_Customer {
  id              String            @id
  fullName        String
  email           String            @unique
  phoneNumber     String            @unique
  password        String
  status          CustomerStatus    @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  clientId        String?
  image           String?
  isActive        Boolean           @default(true)
  Client          Client?           @relation(fields: [clientId], references: [id])
  CustomerRequest CustomerRequest[]

  @@index([clientId])
  @@index([email])
  @@index([isActive])
  @@index([phoneNumber])
  @@index([status])
  @@map("Customer")
  @@schema("public")
}

model CustomerRequest {
  id          String          @id
  status      REQUEST_STATUS  @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime
  customerId  String
  notes       String?
  requestType String
  vehicleId   String
  Customer    public_Customer @relation(fields: [customerId], references: [id])
  Vehicle     Vehicle         @relation(fields: [vehicleId], references: [id])

  @@index([createdAt])
  @@index([customerId])
  @@index([requestType])
  @@index([status])
  @@index([vehicleId])
  @@schema("public")
}

model Document {
  id                   String              @id
  aadharNumber         String
  aadharFrontImage     String?
  aadharBackImage      String?
  voterIdNumber        String
  voterIdImage         String
  panCardNumber        String
  panCardImage         String
  drivingLicenseNumber String
  drivingLicenseImage  String
  localAddressProof    String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime
  userId               String
  BankAccountDetails   BankAccountDetails?
  User                 public_User         @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@schema("public")
}

model HelpSupport {
  id        String              @id
  subject   String
  message   String
  userId    String?
  status    HELP_SUPPORT_STATUS @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime

  @@index([createdAt])
  @@index([status])
  @@index([subject])
  @@index([userId])
  @@schema("public")
}

model Invoice {
  id            String         @id
  invoiceNumber String         @unique
  clientId      String
  status        INVOICE_STATUS @default(PENDING)
  issueDate     DateTime
  dueDate       DateTime
  subtotal      Float
  taxAmount     Float
  totalAmount   Float
  notes         String?
  pdfUrl        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  Client        Client         @relation(fields: [clientId], references: [id])
  InvoiceItem   InvoiceItem[]
  Payment       Payment[]

  @@index([clientId])
  @@index([dueDate])
  @@index([invoiceNumber])
  @@index([issueDate])
  @@index([status])
  @@schema("public")
}

model InvoiceItem {
  id          String  @id
  invoiceId   String
  name        String
  description String?
  quantity    Int
  unitPrice   Float
  amount      Float
  Invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@schema("public")
}

model LeaveRequest {
  id                                   String       @id
  userId                               String
  startDate                            DateTime
  endDate                              DateTime
  reason                               String?
  status                               LEAVE_STATUS @default(PENDING)
  approvedById                         String?
  createdAt                            DateTime     @default(now())
  updatedAt                            DateTime
  leaveType                            LEAVE_TYPE
  adminNote                            String?
  User_LeaveRequest_approvedByIdToUser public_User? @relation("LeaveRequest_approvedByIdToUser", fields: [approvedById], references: [id])
  User_LeaveRequest_userIdToUser       public_User  @relation("LeaveRequest_userIdToUser", fields: [userId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@schema("public")
}

model OperatorClientAssignment {
  id         String      @id
  userId     String
  clientId   String
  assignedAt DateTime    @default(now())
  Client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  User       public_User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
  @@index([userId])
  @@schema("public")
}

model ParkingSlot {
  id        String     @id
  clientId  String
  status    SlotStatus @default(AVAILABLE)
  slotLabel String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  Client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, status])
  @@schema("public")
}

model Payment {
  id                 String               @id
  clientId           String
  invoiceId          String?
  amount             Float
  currency           String               @default("INR")
  status             PaymentStatus        @default(PENDING)
  paymentType        PaymentType
  paymentMethod      PaymentMethodType?
  gateway            PaymentGateway
  subscriptionId     String?
  receiptUrl         String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  Client             Client               @relation(fields: [clientId], references: [id])
  Invoice            Invoice?             @relation(fields: [invoiceId], references: [id])
  PaymentAuditLog    PaymentAuditLog[]
  PaymentTransaction PaymentTransaction[]
  Refund             Refund[]

  @@index([clientId])
  @@index([clientId, status])
  @@index([createdAt])
  @@index([createdAt, status])
  @@index([gateway])
  @@index([invoiceId])
  @@index([paymentMethod])
  @@index([status])
  @@schema("public")
}

model PaymentAuditLog {
  id        String   @id
  paymentId String
  action    String
  actorType String
  actorId   String?
  oldValue  Json?
  newValue  Json?
  metadata  Json?
  createdAt DateTime @default(now())
  Payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([actorType, actorId])
  @@index([createdAt])
  @@index([paymentId])
  @@schema("public")
}

model PaymentTransaction {
  id            String             @id
  paymentId     String
  amount        Float
