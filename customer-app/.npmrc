# Fix pnpm hoisting issues for React Native
shamefully-hoist=true
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*regenerator-runtime*
public-hoist-pattern[]=*@babel*
public-hoist-pattern[]=*@react-native*
public-hoist-pattern[]=*@react-native-firebase*
public-hoist-pattern[]=*@react-native/virtualized-lists*
public-hoist-pattern[]=*@react-native/community*
public-hoist-pattern[]=*@react-native/polyfills*
public-hoist-pattern[]=*@react-native-async-storage*
