# Copy to .env and fill in values. Required for Backend to run.

# Database (required). Use local Postgres or RDS.
# Local: run `pnpm db:up:local` from repo root, then use:
DATABASE_URL=postgresql://abhishekkumar@localhost:5432/valet_db?schema=customer

# Server
PORT=9000
NODE_ENV=development

# JWT (defaults exist; set in production)
# JWT_SECRET=your-secret
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=30d

# Redis (optional; OTP uses in-memory fallback if unset)
# REDIS_URL=redis://localhost:6379

# SMS in development uses Mock; no env needed. For production:
# SMS_SERVICE=MOCK|GMAIL|GUPIO
# FLASH49_* or GMAIL_* as needed

# AI (optional). Use Flash-Lite to reduce Gemini cost for most text workloads.
# GEMINI_API_KEY=your-key
# GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
# GEMINI_VOICE_MODEL=gemini-2.5-flash-lite

# Database Connection Pooling (defaults: 15 in prod, 5 in dev)
# DATABASE_POOL_MAX=20
# DATABASE_POOL_IDLE_MS=30000
# DATABASE_POOL_CONN_TIMEOUT_MS=10000

# Trip Expense Calculator (TollGuru API for toll + fuel cost)
# Get your key: https://tollguru.com/developers/get-api-key
# TOLLGURU_API_KEY=your-tollguru-api-key
