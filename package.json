{
    "name": "customer-2.0-monorepo",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "db:up": "docker compose up -d",
        "db:up:local": "bash scripts/db-start.sh",
        "db:migrate": "pnpm --filter @repo/db-customer prisma:migrate:dev",
        "db:setup": "bash scripts/db-start.sh && sleep 3 && pnpm db:migrate",
        "prisma:migrate:dev": "pnpm --filter @repo/db-customer prisma:migrate:dev",
        "prisma:migrate:deploy": "pnpm --filter @repo/db-customer prisma:migrate:deploy",
        "prisma:generate": "pnpm --filter @repo/db-customer prisma:generate",
        "prisma:studio": "pnpm --filter @repo/db-customer prisma:studio",
        "admin:dev": "pnpm --filter admin-dashboard dev",
        "admin:build": "pnpm --filter admin-dashboard build"
    },
    "devDependencies": {
        "prettier": "latest",
        "turbo": "latest",
        "typescript": "latest"
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "pnpm@9.0.0",
    "pnpm": {
        "patchedDependencies": {
            "@react-native-voice/voice@3.2.4": "patches/@react-native-voice__voice@3.2.4.patch"
        },
        "overrides": {
            "react": "19.2.0",
            "react-is": "19.2.0",
            "react-test-renderer": "19.2.0"
        }
    }
}