# Version control
.git
.gitignore
.husky

# Dependencies (Docker will install them fresh)
node_modules
**/node_modules

# Compiled output (Docker will build fresh)
dist
**/dist

# Environment files (inject at runtime, never bake into image)
.env
.env.*
**/.env
**/.env.*

# Dev configs and docs
.cursor
*.md
!README.md

# Mobile packages (not needed in backend image)
Mobile
Mobile-v2
MobileApp

# Uploads (runtime data, not part of image)
Backend/uploads

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS noise
.DS_Store
Thumbs.db

# Test artifacts
coverage
*.test.ts
*.spec.ts
