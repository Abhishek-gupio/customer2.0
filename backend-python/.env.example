# DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_REDIRECT_URI=

# Google OAuth
# GOOGLE_CLIENT_ID=

# Telematics
TELEMATICS_DEFAULT_PROVIDER=damoov
