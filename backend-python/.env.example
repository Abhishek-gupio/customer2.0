# Copy to .env and fill in values.
# Mirrors Backend/.env.example — same variable names, same defaults.

# Database (same PostgreSQL instance as Node.js backend)
DATABASE_URL=postgresql+asyncpg://abhishekkumar@localhost:5432/valet_db

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGIN=*
RATE_LIMIT_MAX=300

# JWT — must match Backend JWT_SECRET exactly for dual-run compatibility
JWT_SECRET=dev-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
ADMIN_JWT_EXPIRY=24h

# OTP
OTP_EXPIRY_SEC=300
OTP_RATE_LIMIT_WINDOW_SEC=30

# Redis (optional; OTP uses in-memory fallback if unset)
# REDIS_URL=redis://localhost:6379
# REDIS_ENABLED=true

# SMS Service
SMS_SERVICE=MOCK
# FLASH49_USERNAME=
# FLASH49_PASSWORD=
# FLASH49_FROM=
# FLASH49_DLT_CONTENT_ID=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=Gupio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# AI
# GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_VOICE_MODEL=gemini-2.5-flash-lite
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Maps
# GOOGLE_MAPS_API_KEY=

# Storage
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# PUBLIC_BASE_URL=https://api.example.com
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# DigiLocker
